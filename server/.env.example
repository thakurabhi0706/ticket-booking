# ---- Server ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173          # public frontend URL — used in email links

# ---- Database ----
DATABASE_URL=
DB_POOL_MAX=40                     # pg pool size; raise for burst seat-hold load
DB_CONNECT_TIMEOUT_MS=15000

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
AUTH_RATE_LIMIT_PER_MIN=20        # requests/min/IP on /auth/*

# ---- Seat hold ----
SEAT_HOLD_TTL_SECONDS=600              # 600 in prod; 60 for demos
MAX_SEATS_PER_BOOKING=6

# ---- Waitlist ----
WAITLIST_OFFER_TTL_SECONDS=900         # 900 in prod; 120 for demos
WAITLIST_MAX_SEATS=6

# ---- Scheduler ----
SWEEPER_INTERVAL_MS=15000
SWEEP_LOCK_KEY=845213                  # postgres advisory lock key (any integer)

# ---- Booking policy ----
CANCELLATION_CUTOFF_MINUTES=60         # no cancellations within 60 min of showtime

# ---- Email ----
# Two transports are supported; both are plain HTTPS, no extra dependencies.
#   brevo  — verify ONE sender address (e.g. your Gmail), then send to anyone. 300/day free.
#   resend — requires a fully verified DOMAIN before it will send to anyone but you.
MAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM=CineWave Tickets <onboarding@resend.dev>
MAIL_REDIRECT_TO=                      # LEAVE EMPTY in normal use — mail then goes to the actual booker.
                                       # Set it only to force ALL mail into one inbox (staging/demo).
MAIL_FALLBACK_TO=                      # Optional. Used only when the provider REFUSES the real recipient
                                       # (Resend without a verified domain only delivers to the account
                                       # owner). Keeps a copy reaching you instead of losing the mail.

# ---- SMS notifications ----
# Booking confirmations always go to the customer's REGISTERED email (plus the checkout
# contact address when it differs). SMS is an optional extra channel.
SMS_ENABLED=false                      # set true to also text the customer
SMS_PROVIDER=console                   # console | twilio | msg91 | fast2sms
SMS_DEFAULT_COUNTRY_CODE=91            # applied to bare 10-digit numbers
# Twilio (global; Indian numbers also need DLT registration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# MSG91 (India; needs a DLT-approved template)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Fast2SMS (India)
FAST2SMS_API_KEY=

# ---- Tickets ----
TICKET_SIGNING_SECRET=another-long-random-string-min-32-chars

# ---- Seed admin ----
ADMIN_EMAIL=admin@ticketing.dev
ADMIN_PASSWORD=Admin@12345

# ---- Client (client/.env) ----
# VITE_API_URL=http://localhost:4000/api
